# Install as /etc/nebulens/nebulens.env (chmod 600, owner root). Used by nebulens.service.
NEBULENS_HOST=0.0.0.0
NEBULENS_PORT=4318
NEBULENS_DB=/var/lib/nebulens/nebulens.db
NEBULENS_TOKEN=change-me-use-openssl-rand-hex-24
NEBULENS_RETENTION_HOURS=72
# Optional: use Postgres instead of SQLite
# NEBULENS_DATABASE_URL=postgresql://user:password@db-host:5432/nebulens?sslmode=require
