# systemd unit for running Oscilyx without Docker. See ON-PREM.md, "VM without Docker".
[Unit]
Description=Oscilyx observability server
After=network-online.target
Wants=network-online.target

[Service]
User=oscilyx
Group=oscilyx
WorkingDirectory=/opt/oscilyx
EnvironmentFile=/etc/oscilyx/oscilyx.env
ExecStart=/opt/oscilyx/venv/bin/python -u server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/oscilyx

[Install]
WantedBy=multi-user.target
