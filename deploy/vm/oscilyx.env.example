# Install as /etc/oscilyx/oscilyx.env (chmod 600, owner root). Used by oscilyx.service.
OSCILYX_HOST=0.0.0.0
OSCILYX_PORT=4318
OSCILYX_DB=/var/lib/oscilyx/oscilyx.db
OSCILYX_TOKEN=change-me-use-openssl-rand-hex-24
OSCILYX_RETENTION_HOURS=72
# Optional: use Postgres instead of SQLite
# OSCILYX_DATABASE_URL=postgresql://user:password@db-host:5432/oscilyx?sslmode=require
